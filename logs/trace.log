u064a. \\u0644\\u064a\\u0647 \\u0627\\u0644\\u0633\\u0639\\u0631 \\u062f\\u0647\\u061f \\u0623\\u0642\\u0644 \\u0628\\u0643\\u062a\\u064a\\u0631 \\u0645\\u0646 Bath & Body Works \\u0648\\u0627\\u0644\\u0645\\u062d\\u0644\\u064a \\u0627\\u0644\\u0641\\u0627\\u062e\\u0631 \\u0623\\u0648\\u064a\\u060c \\u0648\\u0641\\u064a \\u0646\\u0641\\u0633 \\u0627\\u0644\\u0648\\u0642\\u062a \\u0628\\u064a\\u063a\\u0637\\u0649 \\u062a\\u0643\\u0644\\u0641\\u0629 \\u0627\\u0644\\u062e\\u0627\\u0645\\u0627\\u062a (\\u0627\\u0644\\u0635\\u0648\\u064a\\u0627 \\u0623\\u063a\\u0644\\u0649 \\u0645\\u0646 \\u0627\\u0644\\u0628\\u0631\\u0627\\u0641\\u064a\\u0646) \\u0648\\u064a\\u062f\\u064a\\u0643 \\u0647\\u0627\\u0645\\u0634 \\u0631\\u0628\\u062d \\u0645\\u062d\\u062a\\u0631\\u0645 (Markup \\u0645\\u0646 2.5x \\u0644\\u0640 3x).", "confidence": null, "source": null, "evidence": []}, {"title": "2. \\u0627\\u0644\\u0634\\u0645\\u0639\\u0629 \\u0627\\u0644\\u0643\\u0628\\u064a\\u0631\\u0629 (Large Jar / Double Wick - \\u062d\\u0648\\u0627\\u0644\\u064a 300 \\u0625\\u0644\\u0649 350 \\u062c\\u0631\\u0627\\u0645)", "detail": "\\u0627\\u0644\\u0645\\u0648\\u0627\\u0635\\u0641\\u0627\\u062a: \\u0628\\u0631\\u0637\\u0645\\u0627\\u0646 \\u0623\\u0643\\u0628\\u0631\\u060c \\u0628\\u0641\\u062a\\u064a\\u0644\\u064a\\u0646 (Double Wick) \\u0639\\u0634\\u0627\\u0646 \\u0627\\u0646\\u062a\\u0634\\u0627\\u0631 \\u0627\\u0644\\u0631\\u0627\\u0626\\u062d\\u0629 (Scent Throw) \\u064a\\u0643\\u0648\\u0646 \\u0623\\u0642\\u0648\\u0649\\u060c \\u0632\\u064a \\u0641\\u0643\\u0631\\u0629 \\u0627\\u0644\\u0640 3-Wick \\u0628\\u0633 \\u0628\\u062d\\u062c\\u0645 \\u0645\\u0646\\u0627\\u0633\\u0628 \\u0644\\u0644\\u0645\\u0635\\u0631\\u064a\\u064a\\u0646 \\u0648\\u0628\\u0641\\u062a\\u064a\\u0644\\u064a\\u0646. \\u0627\\u0644\\u0633\\u0639\\u0631 \\u0627\\u0644\\u0645\\u0642\\u062a\\u0631\\u062d \\u0644\\u0644\\u0645\\u0646\\u0627\\u0641\\u0633\\u0629: \\u0645\\u0646 650 \\u0625\\u0644\\u0649 750 \\u062c\\u0646\\u064a\\u0647 \\u0645\\u0635\\u0631\\u064a. \\u0644\\u064a\\u0647 \\u0627\\u0644\\u0633\\u0639\\u0631 \\u062f\\u0647\\u061f \\u0628\\u062f\\u064a\\u0644 \\u0645\\u0645\\u062a\\u0627\\u0632 \\u0648\\u0639\\u0645\\u0644\\u064a \\u0644\\u0644\\u064a \\u0628\\u064a\\u062d\\u0628\\u0648\\u0627 \\u0634\\u0645\\u0648\\u0639 Bath & Body Works \\u0627\\u0644\\u0643\\u0628\\u064a\\u0631\\u0629 \\u0628\\u0633 \\u0645\\u0634 \\u0639\\u0627\\u064a\\u0632\\u064a\\u0646 \\u064a\\u062f\\u0641\\u0639\\u0648\\u0627 \\u0623\\u0631\\u0642\\u0627\\u0645 \\u0641\\u0644\\u0643\\u064a\\u0629 \\u0641\\u064a \\u0634\\u0645\\u0639\\u0629 \\u0645\\u0633\\u062a\\u0648\\u0631\\u062f\\u0629.", "confidence": null, "source": null, "evidence": []}, {"title": "3. \\u0627\\u0644\\u062d\\u062c\\u0645 \\u0627\\u0644\\u0635\\u063a\\u064a\\u0631 / \\u0627\\u0644\\u062a\\u0633\\u062a\\u0631\\u0627\\u062a \\u0623\\u0648 \\u0627\\u0644\\u0647\\u062f\\u0627\\u064a\\u0627 (Mini/Travel Tin or Jar - \\u062d\\u0648\\u0627\\u0644\\u064a 100 \\u062c\\u0631\\u0627\\u0645)", "detail": "\\u0627\\u0644\\u0645\\u0648\\u0627\\u0635\\u0641\\u0627\\u062a: \\u0639\\u0644\\u0628\\u0629 \\u0635\\u0641\\u064a\\u062d (Tin) \\u0623\\u0648 \\u0628\\u0631\\u0637\\u0645\\u0627\\u0646 \\u0635\\u063a\\u064a\\u0631 \\u0644\\u0644\\u0633\\u0641\\u0631 \\u0623\\u0648 \\u0627\\u0644\\u062a\\u062c\\u0631\\u0628\\u0629. \\u0627\\u0644\\u0633\\u0639\\u0631 \\u0627\\u0644\\u0645\\u0642\\u062a\\u0631\\u062d \\u0644\\u0644\\u0645\\u0646\\u0627\\u0641\\u0633\\u0629: \\u0645\\u0646 200 \\u0625\\u0644\\u0649 250 \\u062c\\u0646\\u064a\\u0647 \\u0645\\u0635\\u0631\\u064a. \\u0644\\u064a\\u0647 \\u0627\\u0644\\u0633\\u0639\\u0631 \\u062f\\u0647\\u061f \\u062f\\u0647 \\u0628\\u064a\\u0643\\u0648\\u0646 \\"Entry Point\\" \\u0623\\u0648 \\u0628\\u0627\\u0628 \\u062f\\u062e\\u064a\\u0644 \\u0644\\u0644\\u0639\\u0645\\u064a\\u0644 \\u0627\\u0644\\u0644\\u064a \\u062e\\u0627\\u064a\\u0641 \\u064a\\u062c\\u0631\\u0628 \\u0628\\u0631\\u0627\\u0646\\u062f \\u062c\\u062f\\u064a\\u062f \\u0644\\u0623\\u0648\\u0644 \\u0645\\u0631\\u0629\\u060c \\u0623\\u0648 \\u0644\\u0639\\u0631\\u0648\\u0636 \\u0627\\u0644\\u0640 Giveaways \\u0648\\u0627\\u0644\\u0628\\u0627\\u0632\\u0627\\u0631\\u0627\\u062a.", "confidence": null, "source": null, "evidence": []}]}, {"id": null, "type": "text", "text": "\\u062b\\u0627\\u0644\\u062b\\u0627\\u064b: \\u0645\\u0639\\u0627\\u062f\\u0644\\u0629 \\u0627\\u0644\\u062d\\u0645\\u0627\\u064a\\u0629 \\u0648\\u0636\\u0645\\u0627\\u0646 \\u0627\\u0644\\u0631\\u0628\\u062d\\u064a\\u0629 (\\u0643\\u064a\\u0641 \\u062a\\u062d\\u0633\\u0628 \\u0633\\u0639\\u0631\\u0643 \\u0628\\u0627\\u0644\\u0638\\u0628\\u0637\\u061f)\\n\\n\\u0642\\u0628\\u0644 \\u0645\\u0627 \\u062a\\u0633\\u062a\\u0642\\u0631 \\u0639\\u0644\\u0649 \\u0627\\u0644\\u0633\\u0639\\u0631 \\u0627\\u0644\\u0646\\u0647\\u0627\\u0626\\u064a\\u060c \\u0644\\u0627\\u0632\\u0645 \\u062a\\u0637\\u0628\\u0642 \\u0627\\u0644\\u0642\\u0627\\u0639\\u062f\\u0629 \\u062f\\u064a \\u0628\\u062f\\u0642\\u0629:\\n\\u0633\\u0639\\u0631 \\u0627\\u0644\\u0628\\u064a\\u0639 \\u0644\\u0644\\u0639\\u0645\\u064a\\u0644 = (\\u062a\\u0643\\u0644\\u0641\\u0629 \\u0627\\u0644\\u062e\\u0627\\u0645\\u0627\\u062a \\u0627\\u0644\\u0645\\u0628\\u0627\\u0634\\u0631\\u0629: \\u0634\\u0645\\u0639 + \\u0632\\u064a\\u062a \\u0639\\u0637\\u0631\\u064a + \\u0641\\u062a\\u064a\\u0644 + \\u0628\\u0631\\u0637\\u0645\\u0627\\u0646 + \\u0644\\u0627\\u0641\\u062a\\u0629/\\u0628\\u0627\\u0643\\u064a\\u062c\\u064a\\u0646\\u062c) \\u00d7 3\\n\\n- \\u0644\\u064a\\u0647 \\u00d7 3\\u061f\\n  - \\u0627\\u0644\\u062b\\u0644\\u062b \\u0627\\u0644\\u0623\\u0648\\u0644 \\u064a\\u063a\\u0637\\u064a \\u0627\\u0644\\u062a\\u0643\\u0644\\u0641\\u0629 \\u0627\\u0644\\u0641\\u0639\\u0644\\u064a\\u0629 \\u0644\\u0644\\u0645\\u0646\\u062a\\u062c.\\n  - \\u0627\\u0644\\u062b\\u0644\\u062b \\u0627\\u0644\\u062b\\u0627\\u0646\\u064a \\u064a\\u063a\\u0637\\u064a \\u0645\\u0635\\u0631\\u0648\\u0641\\u0627\\u062a \\u0627\\u0644\\u062a\\u0634\\u063a\\u064a\\u0644 (\\u0627\\u0644\\u062a\\u063a\\u0644\\u064a\\u0641 \\u0627\\u0644\\u0625\\u0636\\u0627\\u0641\\u064a \\u0644\\u0644\\u0634\\u062d\\u0646\\u060c \\u0627\\u0644\\u0625\\u0639\\u0644\\u0627\\u0646\\u0627\\u062a \\u0639\\u0644\\u0649 \\u0627\\u0644\\u0633\\u0648\\u0634\\u064a\\u0627\\u0644 \\u0645\\u064a\\u062f\\u064a\\u0627\\u060c \\u0639\\u0645\\u0648\\u0644\\u0627\\u062a \\u0645\\u0646\\u0635\\u0627\\u062a \\u0627\\u0644\\u0628\\u064a\\u0639 \\u0623\\u0648 \\u0627\\u0644\\u0628\\u0627\\u0632\\u0627\\u0631\\u0627\\u062a).\\n  - \\u0627\\u0644\\u062b\\u0644\\u062b \\u0627\\u0644\\u062b\\u0627\\u0644\\u062b \\u0647\\u0648 \\u0635\\u0627\\u0641\\u064a \\u0623\\u0631\\u0628\\u0627\\u062d\\u0643 \\u0627\\u0644\\u0630\\u064a \\u062a\\u0633\\u062a\\u062b\\u0645\\u0631\\u0647 \\u0644\\u062a\\u0637\\u0648\\u064a\\u0631 \\u0627\\u0644\\u0628\\u0631\\u0627\\u0646\\u062f."}, {"id": null, "type": "findings", "title": "\\u0631\\u0627\\u0628\\u0639\\u0627\\u064b: \\u0646\\u0635\\u064a\\u062d\\u0629 \\u062a\\u0633\\u0648\\u064a\\u0642\\u064a\\u0629 \\u062a\\u0646\\u0627\\u0641\\u0633 \\u0628\\u0647\\u0627 \\u0639\\u0645\\u0627\\u0644\\u0642\\u0629 \\u0645\\u062b\\u0644 Bath & Body Works", "findings": [{"title": "\\u0627\\u0644\\u0642\\u0635\\u0629 (Storytelling)", "detail": "\\u0631\\u0643\\u0632 \\u0625\\u0646 \\u0634\\u0645\\u0639\\u062a\\u0643 \\u0645\\u0635\\u0646\\u0648\\u0639\\u0629 \\u0645\\u0646 \\u0635\\u0648\\u064a\\u0627 \\u0637\\u0628\\u064a\\u0639\\u064a\\u0629 100% (\\u062e\\u0627\\u0644\\u064a\\u0629 \\u0645\\u0646 \\u0633\\u0645\\u0648\\u0645 \\u0627\\u0644\\u0628\\u0631\\u0627\\u0641\\u064a\\u0646 \\u0627\\u0644\\u0644\\u064a \\u0645\\u0648\\u062c\\u0648\\u062f\\u0629 \\u0641\\u064a \\u0628\\u0639\\u0636 \\u0627\\u0644\\u0634\\u0645\\u0648\\u0639 \\u0627\\u0644\\u062a\\u062c\\u0627\\u0631\\u064a\\u0629 \\u0627\\u0644\\u0631\\u062e\\u064a\\u0635\\u0629).", "confidence": null, "source": null, "evidence": []}, {"title"