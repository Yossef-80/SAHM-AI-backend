    * statement: INSERT INTO messages (id, conversation_id, role, content, blocks, task_id, persona_id) VALUES ($1::VARCHAR, $2::VARCHAR, $3::VARCHAR, $4::VARCHAR, $5::JSONB, $6::VARCHAR, $7::VARCHAR) RETURNING messages.created_at
    * parameters: ('msg_aca6b5c764f949e5ad06', 'conv_888b9b662f8d4bbebf5f', 'assistant', 'تحليل البراند (Brand Analysis) لمشروع الشموع الخاص بك يرتكز على الفجوة الحقيقية في السوق المصري (السعرية والجودة)، ويتمثل في النقاط التالية:\n\nالتموضع في السوق (Market Positioning)\n- الفئة السعرية المستهدفة: الشريحة المتوسطة-العليا (Mid-to-High Artisanal Sweet Spot) من 600 إلى 850 جنيهًا.\n- الموقع التنافسي: تتواجد في الفراغ الموجود بين الشمع التجاري الرخيص (أقل من 350 جنيهاً) وبين البراندات الفاخرة جداً أو المستوردة (التي تتجاوز 950 إلى 1,400 جنيه). هذا يمنحك ميزة تقديم "رفاهية ميسورة" (Affordable Luxury) بجودة عالية وبسعر منافس.\n\nنقاط القوة الفريدة (USPs - Unique Selling Propositions)\n- الخامات الصحية: الاعتماد حصرياً على شمع الصويا الطبيعي وفتلات القطن الكلاسيكية، لتجنب الأضرار الصحية والصداع الناتج عن الشمع البارافين التقليدي.\n- الاستدامة وعنصر الديكور: استخدام حاويات زجاجية سميكة ومقاومة للحرارة مصممة خصيصاً لإعادة استخدامها لأغراض الديكور المنزلي بعد انتهاء الشمع (Multi-cycle upcycling)، وهو ما يحل مشكلة شعور المستهلك بذنب رمي العبوات الباهظة.\n- تركيبات عطرية غير تقليدية: الابتعاد عن الروائح المكررة بالسوق والتركيز على الروائح الدافئة والمهدئة مثل الفانيليا، اللافندر، عطور العود الشرقي الممزوجة بلمسات نباتية محلية تناسب الذوق المصري الراقي.\n\nالجمهور المستهدف (Target Audience)\n- طبيعة المهتمين: عشاق الديكور المنزلي الداخلي، المهتمون بالصحة والعافية (Wellness & Self-care)، والباحثون عن منتجات حرفية محلية تعكس الذوق الرفيع.\n- المناطق الجغرافية: متواجدون في المناطق الحضرية الراقية (القاهرة الجديدة، التجمع، الشيخ زايد، الزمالك، المعادي، وسموحة بالإسكندرية).\n\nفرص النمو المستقبلية (Growth Vectors)\n- القطاع التجاري والضيافة B2B: برامج التصنيع الخاص (Private Label) للسبا والبوتيك هوتيلز.\n- الاشتراكات الموسمية: صناديق الهدايا الفصلية (Quarterly Sensory Subscription Boxes) لضمان ولاء العملاء ومنع ملل العلامة التجارية.', [{'id': None, 'type': 'text', 'text': 'تحليل البراند (Brand Analysis) لمشروع الشموع الخاص بك يرتكز على الفجوة الحقيقية في السوق المصري (السعرية والجودة)، ويتمثل في النقاط التالية:'}, {'id': None, 'type': 'findings', 'title': 'التموضع في السوق (Market Positioning)', 'findings': [{'title': 'الفئة السعرية المستهدفة', 'detail': 'الشريحة المتوسطة-العليا (Mid-to-High Artisanal Sweet Spot) من 600 إلى 850 جنيهًا.', 'confidence': None, 'source': None, 'evidence': []}, {'title': 'الموقع التنافسي', 'detail': 'تتواجد في الفراغ الموجود بين الشمع التجاري الرخيص (أقل من 350 جنيهاً) وبين البراندات الفاخرة جداً أو المستوردة (التي تتجاوز 950 إلى 1,400 جنيه). هذا يمنحك ميزة تقديم "رفاهية ميسورة" (Affordable Luxury) بجودة عالية وبسعر منافس.', 'confidence': None, 'source': None, 'evidence': []}]}, {'id': None, 'type': 'findings', 'title': 'نقاط القوة الفريدة (USPs - Unique Selling Propositions)', 'findings': [{'title': 'الخامات الصحية', 'detail': 'الاعتماد حصرياً على شمع الصويا الطبيعي وفتلات القطن الكلاسيكية، لتجنب الأضرار الصحية والصداع الناتج عن الشمع البارافين التقليدي.', 'confidence': None, 'source': None, 'evidence': []}, {'title': 'الاستدامة وعنصر الديكور', 'detail': 'استخدام حاويات زجاجية سميكة ومقاومة للحرارة مصممة خصيصاً لإعادة استخدامها لأغراض الديكور المنزلي بعد انتهاء الشمع (Multi-cycle upcycling)، وهو ما يحل مشكلة شعور المستهلك بذنب رمي العبوات الباهظة.', 'confidence': None, 'source': None, 'evidence': []}, {'title': 'تركيبات عطرية غير تقليدية', 'detail': 'الابتعاد عن الروائح المكررة بالسوق والتركيز على الروائح الدافئة والمهدئة مثل الفانيليا، اللافندر، عطور العود الشرقي الممزوجة بلمسات نباتية محلية تناسب الذوق المصري الراقي.', 'confidence': None, 'source': None, 'evidence': []}]}, {'id': None, 'type': 'findings', 'title': 'الجمهور المستهدف (Target Audience)', 'findings': [{'title': 'طبيعة المهتمين', 'detail': 'عشاق الديكور المنزلي الداخلي، المهتمون بالصحة والعافية (Wellness & Self-care)، والباحثون عن منتجات حرفية محلية تعكس الذوق الرفيع.', 'confidence': None, 'source': None, 'evidence': []}, {'title': 'المناطق الجغرافية', 'detail': 'متواجدون في المناطق الحضرية الراقية (القاهرة الجديدة، التجمع، الشيخ زايد، الزمالك، المعا