# ==============================================================================
# SAHM MARKETING OS - ENVIRONMENT CONFIGURATION
# ==============================================================================
SAHM_ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

API_PREFIX=/api/v1
APP_NAME=Sahm Marketing OS
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=

# --- Object storage (generated creatives, mirrored uploads) -------------------
# The secret key above doubles as the Storage credential. With both set, every
# generated image is uploaded to issue-free public URLs instead of being stored
# as megabytes of base64 inside `creatives.url`.
SAHM_STORAGE_BUCKET=creatives
# Local fallback used when Supabase is not configured (dev/test only).
PUBLIC_ASSET_BASE_URL=

# --- Database diagnostics ----------------------------------------------------
# Full per-query tracing is opt-in: it cleans and redacts every parameter of
# every statement. Slow queries always warn, tracing on or off.
DB_TRACE=false
DB_SLOW_QUERY_MS=1000


# ==============================================================================
# 🧠 AI LLM PROVIDER CONFIGURATION
# ==============================================================================
# Select your active provider here (Options: ollama, groq, gemini, openai, anthropic, openrouter)
AI_LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 1. GROQ SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. OLLAMA SETTINGS (Local / Ngrok)
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=ollama; this is the general LLM model.
OLLAMA_MODEL="hf.co/Aldaris/Qwen3-8B-Q4_K_M-GGUF:Q4_K_M"
# General Ollama tunnel only; keep this separate from the dedicated ads VLM tunnel.
OLLAMA_BASE_URL=https://eleven-bulgur-curtsy.ngrok-free.dev/
OLLAMA_TIMEOUT_SECONDS=1000

# Optional independent provider/model for reference-image vision.
# This overrides the system's AI_LLM_PROVIDER / AI_LLM_MODEL only for VLM analysis.
# Uncomment both lines to route reference-image analysis to Gemini; GEMINI_API_KEY is required.
# AI_ADS_VLM_PROVIDER=gemini
# AI_ADS_VLM_MODEL=gemini-3.5-flash
# Supported provider values match AI_LLM_PROVIDER (ollama, openai, anthropic, gemini, groq, openrouter, mock).
# If AI_ADS_VLM_PROVIDER is set, AI_ADS_VLM_MODEL must be set (except Ollama may use VLM_OLLAMA_MODEL).

# Legacy dedicated Ollama-compatible tunnel for reference-image vision.
# Used when AI_ADS_VLM_PROVIDER is unset; use the VLM notebook's PUBLIC_URL root (no /api or /v1).
AI_ADS_VLM_BASE_URL=
# Set to the exact vision-capable model tag installed on the dedicated VLM server.
# Example only if that server has it: qwen3-vl:8b
# VLM_OLLAMA_MODEL=qwen3-vl:8b
# Maximum decoded pixels sent for reference analysis (original upload is retained).
# A 1080x1350 image becomes about 894x1118 at this setting.
AI_ADS_VLM_MAX_PIXELS=1000000

# ------------------------------------------------------------------------------
# 3. GEMINI SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. OPENAI SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. ANTHROPIC (CLAUDE) SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. OPENROUTER SETTINGS (Aggregator for Free Models)
# ------------------------------------------------------------------------------
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_API_KEY=

# ==============================================================================
# 🔍 SEARCH & AGENT CONFIGURATION
# ==============================================================================
# Search Provider (tavily, serper, brave, none)
AI_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
AI_ALLOW_PAID_SEARCH_CALLS=false

# Limits & Cost Guards
DAILY_TOKEN_BUDGET=2000000

# Website Scraping Tools
WEBSITE_ALLOWED_SCHEMES=http,https
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_MAX_BYTES=2000000

# ==============================================================================
# 💾 DATABASE & MEMORY
# ==============================================================================
# Main App Database


# AI Agent Memory & Checkpoints
AI_SQLITE_PATH=./var/ai_memory.sqlite
AI_DB_PROVIDER=memory
# ==============================================================================
# 📊 THIRD-PARTY INTEGRATIONS
# ==============================================================================
# Social Media (Meta)
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v26.0
META_API_TIMEOUT_SECONDS=20
META_APP_ID=
META_APP_SECRET=
# Long-lived Meta system-user token (operator-managed; never sent to the frontend).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
TOKEN_ENCRYPTION_KEY=

# File Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
# Non-secret public HTTPS origin for generated image bytes returned as base64.
PUBLIC_ASSET_BASE_URL=https://api.example.com
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/webp,text/csv,application/pdf

# ------------------------------------------------------------ image generation ---
# IMAGE_PROVIDER: mock | openai | stability   (app/config.py -> ImageProviderName)
# The default is `mock`, which generates NO images: generate_image returns
#   "Mock placeholder images are disabled by default. Configure a real image
#    provider, or explicitly enable mock assets for a test workspace."
# Only `openai` is actually wired up in this build; selecting `stability` returns
# unavailable ("configured but not wired up in this build").
# Until IMAGE_PROVIDER=openai AND IMAGE_API_KEY are both set, the image connector
# reports configured=false and the "Create image" button stays disabled.
IMAGE_PROVIDER=openai
# Required unless IMAGE_PROVIDER=mock.
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
# Optional OpenAI-compatible endpoint override (proxies / Azure-style gateways).
IMAGE_BASE_URL=
# Offline placeholder creatives are disabled unless explicitly opted in.
# Set to true ONLY for a test workspace if you have no image provider yet.
IMAGE_ALLOW_MOCK_ASSETS=false

# Other APIs
GOOGLE_PLACES_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

APIFY_TOKEN=
APIFY_API_TOKEN=

# Google Analytics (GA4)
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

AI_ALLOW_PAID_REVIEW_CALLS=false

# ==============================================================================
# 📝 LOGGING
# ==============================================================================
AI_LOG_DIR=./logs
AI_LOG_LEVEL=INFO
AI_LOG_FORMAT=text
AI_LOG_TO_CONSOLE=false
AI_LLM_MAX_TOKENS=16384

# One image per render: the connector's "how many" setting no longer buys extra
# assets, because a paid render is capped to a single image.
# Render ceiling for one image call, in seconds. The provider's own worst case
# for a large edit was measured above 120s, so the old hardcoded 120 cut off
# renders that were about to succeed (and were still billed).
IMAGE_TIMEOUT_SECONDS=300
