# ==============================================================================
# SAHM MARKETING OS - ENVIRONMENT CONFIGURATION
# ==============================================================================
SAHM_ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

API_PREFIX=/api/v1
APP_NAME=Sahm Marketing OS
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# 🧠 AI LLM PROVIDER CONFIGURATION
# ==============================================================================
# Select your active provider here (Options: ollama, groq, gemini, openai, anthropic, openrouter)
AI_LLM_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 1. GROQ SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=groq
GROQ_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 2. OLLAMA SETTINGS (Local / Ngrok)
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=ollama
OLLAMA_MODEL="hf.co/jc-builds/Qwen3.5-9B-VLM-Q4_K_M-GGUF:Q4_K_M"
OLLAMA_BASE_URL=https://eleven-bulgur-curtsy.ngrok-free.dev/
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=300.0

# ------------------------------------------------------------------------------
# 3. GEMINI SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. OPENAI SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. ANTHROPIC (CLAUDE) SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. OPENROUTER SETTINGS (Aggregator for Free Models)
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=openrouter
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=""


# ==============================================================================
# 🔍 SEARCH & AGENT CONFIGURATION
# ==============================================================================
# Search Provider (tavily, serper, brave, none)
AI_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=""

# Limits & Cost Guards
DAILY_TOKEN_BUDGET=2000000
MAX_TOKENS_PER_RUN=60000
MAX_AGENT_ITERATIONS=6
AGENT_RUN_TIMEOUT_SECONDS=300

# Website Scraping Tools
WEBSITE_ALLOWED_SCHEMES=http,https
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_MAX_BYTES=2000000

# ==============================================================================
# 💾 DATABASE & MEMORY
# ==============================================================================
# Main App Database
DATABASE_URL=sqlite+aiosqlite:///./sahm.db

# AI Agent Memory & Checkpoints
AI_DB_PROVIDER=sqlite
AI_SQLITE_PATH=./var/ai_memory.sqlite
BRAND_CONTEXT_TOKEN_CAP=900

# ==============================================================================
# 📊 THIRD-PARTY INTEGRATIONS
# ==============================================================================
# Social Media (Meta)
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v21.0
META_API_TIMEOUT_SECONDS=20
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
TOKEN_ENCRYPTION_KEY=

# File Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/webp,text/csv,application/pdf

# Other APIs
GOOGLE_PLACES_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ==============================================================================
# 📝 LOGGING
# ==============================================================================
AI_LOG_DIR=./logs
AI_LOG_LEVEL=INFO
AI_LOG_FORMAT=text
AI_LOG_TO_CONSOLE=false
