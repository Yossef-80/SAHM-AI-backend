# ==============================================================================
# SAHM MARKETING OS - ENVIRONMENT CONFIGURATION
# ==============================================================================
SAHM_ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

API_PREFIX=/api/v1
APP_NAME=Sahm Marketing OS
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Main application database.
#   local:      sqlite+aiosqlite:///./sahm.db
#   production: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./sahm.db


# ==============================================================================
# 🧠 AI LLM PROVIDER CONFIGURATION
# ==============================================================================
# Select your active provider here (Options: ollama, groq, gemini, openai, anthropic, openrouter)
AI_LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 1. GROQ SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. OLLAMA SETTINGS (Local / Ngrok)
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=ollama; this is the general LLM model.
OLLAMA_MODEL="hf.co/Aldaris/Qwen3-8B-Q4_K_M-GGUF:Q4_K_M"
# General Ollama tunnel only; keep this separate from the dedicated ads VLM tunnel.
OLLAMA_BASE_URL=https://eleven-bulgur-curtsy.ngrok-free.dev/
OLLAMA_TIMEOUT_SECONDS=1000

# Optional independent provider/model for reference-image vision.
# This overrides the system's AI_LLM_PROVIDER / AI_LLM_MODEL only for VLM analysis.
# Uncomment both lines to route reference-image analysis to Gemini; GEMINI_API_KEY is required.
# AI_ADS_VLM_PROVIDER=gemini
# AI_ADS_VLM_MODEL=gemini-3.5-flash
# Supported provider values match AI_LLM_PROVIDER (ollama, openai, anthropic, gemini, groq, openrouter, mock).
# If AI_ADS_VLM_PROVIDER is set, AI_ADS_VLM_MODEL must be set (except Ollama may use VLM_OLLAMA_MODEL).

# Legacy dedicated Ollama-compatible tunnel for reference-image vision.
# Used when AI_ADS_VLM_PROVIDER is unset; use the VLM notebook's PUBLIC_URL root (no /api or /v1).
AI_ADS_VLM_BASE_URL=
# Set to the exact vision-capable model tag installed on the dedicated VLM server.
# Example only if that server has it: qwen3-vl:8b
# VLM_OLLAMA_MODEL=qwen3-vl:8b
# Maximum decoded pixels sent for reference analysis (original upload is retained).
# A 1080x1350 image becomes about 894x1118 at this setting.
AI_ADS_VLM_MAX_PIXELS=1000000

# ------------------------------------------------------------------------------
# 3. GEMINI SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. OPENAI SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. ANTHROPIC (CLAUDE) SETTINGS
# ------------------------------------------------------------------------------
# Active when AI_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. OPENROUTER SETTINGS (Aggregator for Free Models)
# ------------------------------------------------------------------------------
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_API_KEY=

# ==============================================================================
# 🔍 SEARCH & AGENT CONFIGURATION
# ==============================================================================
# Search Provider (tavily, serper, brave, none)
AI_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
AI_ALLOW_PAID_SEARCH_CALLS=false

# Limits & Cost Guards
DAILY_TOKEN_BUDGET=2000000

# Website Scraping Tools
WEBSITE_ALLOWED_SCHEMES=http,https
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_MAX_BYTES=2000000

# ==============================================================================
# 💾 DATABASE & MEMORY
# ==============================================================================
# Main App Database -- configured once, at the top of this file (DATABASE_URL).

# AI Agent Checkpoints (LangGraph state only -- NOT brand memory)
AI_SQLITE_PATH=./var/ai_memory.sqlite
AI_DB_PROVIDER=memory

# ==============================================================================
# 🧠 BRAND MEMORY
# ==============================================================================
# Layered, lifecycle-managed memory. There are NO embeddings and NO vector
# store: retrieval is BM25 + recency + kind affinity over `brand_memory_items`
# (see docs/MEMORY_ARCHITECTURE.md). Every value below is read by
# app/core/memory/policy.py::MemoryPolicy, and the same names exist on
# app/config.py::Settings and app/ai/settings.py::AISettings.
#
# Units: `*_tokens` are tokens (Arabic and English counted separately by
# app/core/memory/tokens.py); `*_share` and `weight_*` are 0..1 floats;
# `*_seconds`/`*_days` are integers.

# Master switch. false = no brand memory is read or written (the rest of the
# chat still works). Use it to isolate a memory bug from an LLM bug.
MEMORY_ENABLED=true

# --- session layer: raw turns -> rolling summary -----------------------------
# Token ceiling for the conversation history that is sent to the model.
SESSION_MEMORY_MAX_TOKENS=10000
# (legacy alias: MEMORY_SESSION_MAX_TOKENS)
# Number of most recent turns kept verbatim when older turns are summarized.
MEMORY_RETAIN_RECENT_TURNS=2
# Idle time before the background LTM consolidation pass runs. 0 = every turn.
MEMORY_LTM_DEBOUNCE_SECONDS=180
# Token ceiling for the distilled brand profile (facts) before it is re-split.
BRAND_MEMORY_TOKEN_LIMIT=10000
# (legacy aliases: BRAND_IDENTITY_TOKEN_LIMIT, MEMORY_BRAND_MAX_TOKENS)
# Token ceiling for the one-paragraph global user/brand summary.
MEMORY_GLOBAL_PROFILE_MAX_TOKENS=300
# Whole-brand re-extraction: an LLM pass over recent chats that rewrites the
# brand identity and profile. Off = the identity only changes when the Settings
# page is saved. On = it is re-derived, at most once per the interval below.
MEMORY_IDENTITY_SYNC_ENABLED=true
MEMORY_IDENTITY_MIN_INTERVAL_SECONDS=900
# When false (default), the pass only fills BLANK brand-profile fields. A brand
# voice the user typed into Settings is never replaced by an inference from chat.
# Set true only if the agent should own the profile outright.
MEMORY_IDENTITY_OVERWRITE_PROFILE=false

# --- prompt assembly: the "brand context" block ------------------------------
# Hard ceiling for everything memory injects into one prompt. Raising this
# raises every request's cost; 900 tokens is ~6 dense memory rows.
MEMORY_CONTEXT_TOKEN_CAP=900
# Candidate rows requested per retrieval section (identity / episodic).
MEMORY_CONTEXT_TOP_K=6
# How many recent learnings are always considered for the learnings section.
MEMORY_RECENT_LEARNINGS=3
# Share of MEMORY_CONTEXT_TOKEN_CAP reserved for identity facts (0.45 = 405).
MEMORY_IDENTITY_SHARE=0.45
# Share reserved for the active strategy blueprint (0.15 = 135).
MEMORY_PLAN_SHARE=0.15

# --- ranking: BM25 + recency + affinity + importance ------------------------
# How many newest rows are considered per retrieval (bounds Python ranking).
MEMORY_CANDIDATE_WINDOW=300
# Recency half-life: a 30-day-old item scores half of a brand-new one.
MEMORY_RECENCY_HALF_LIFE_DAYS=30
# Weights are normalised by their sum, so only ratios matter.
# Kind/task affinity -- how well the kind fits the current task.
MEMORY_WEIGHT_AFFINITY=0.20
# Query/document term overlap (BM25, Arabic-normalised).
MEMORY_WEIGHT_LEXICAL=0.40
# Freshness.
MEMORY_WEIGHT_RECENCY=0.25
# Author/kind-declared importance.
MEMORY_WEIGHT_IMPORTANCE=0.15
# Extra score for pinned rows (survive relevance filtering entirely).
MEMORY_PINNED_BOOST=0.35
# Extra score for rows attached to the campaign in scope.
MEMORY_CAMPAIGN_BOOST=0.10
# Extra score when the normalised query appears verbatim in the text.
MEMORY_PHRASE_BOOST=0.10
# Below this lexical score a row is dropped when a query is present
# (pinned rows are exempt). Raise it for stricter matching, lower it for recall.
MEMORY_MIN_RELEVANCE=0.12

# --- lifecycle --------------------------------------------------------------
# A repeat write of the same (kind, workspace, campaign, normalised text)
# updates the existing row instead of adding a near-duplicate.
MEMORY_DEDUPE_ENABLED=true
# TTL for kinds that do not declare their own (episodic notes, scratch rows).
MEMORY_DEFAULT_TTL_DAYS=180
# Per-kind ceiling; the lowest-ranked unpinned rows are archived above it.
MEMORY_MAX_ITEMS_PER_KIND=500
# Cap on one stored item's text, before the per-kind cap in the registry.
MEMORY_ITEM_MAX_TOKENS=120
# Run the expired-row sweep on every write (cheap; false = only on /memory/prune).
MEMORY_SWEEP_ON_WRITE=true

# --- removed knobs (kept here so an old .env fails loudly, not silently) ----
# EMBEDDING_PROVIDER / EMBEDDING_MODEL / EMBEDDING_DIM / VECTOR_BACKEND are no
# longer read by anything. If they are still present in a deployment's .env they
# are ignored; delete them.
# ==============================================================================
# 📊 THIRD-PARTY INTEGRATIONS
# ==============================================================================
# Social Media (Meta)
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v26.0
META_API_TIMEOUT_SECONDS=20
META_APP_ID=
META_APP_SECRET=
# Long-lived Meta system-user token (operator-managed; never sent to the frontend).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
TOKEN_ENCRYPTION_KEY=

# File Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
# Non-secret public HTTPS origin for generated image bytes returned as base64.
PUBLIC_ASSET_BASE_URL=https://api.example.com
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/webp,text/csv,application/pdf

# ------------------------------------------------------------ image generation ---
# IMAGE_PROVIDER: mock | openai | stability   (app/config.py -> ImageProviderName)
# The default is `mock`, which generates NO images: generate_image returns
#   "Mock placeholder images are disabled by default. Configure a real image
#    provider, or explicitly enable mock assets for a test workspace."
# Only `openai` is actually wired up in this build; selecting `stability` returns
# unavailable ("configured but not wired up in this build").
# Until IMAGE_PROVIDER=openai AND IMAGE_API_KEY are both set, the image connector
# reports configured=false and the "Create image" button stays disabled.
IMAGE_PROVIDER=openai
# Required unless IMAGE_PROVIDER=mock.
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
# Optional OpenAI-compatible endpoint override (proxies / Azure-style gateways).
IMAGE_BASE_URL=
# Offline placeholder creatives are disabled unless explicitly opted in.
# Set to true ONLY for a test workspace if you have no image provider yet.
IMAGE_ALLOW_MOCK_ASSETS=false

# Other APIs
GOOGLE_PLACES_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

APIFY_TOKEN=
APIFY_API_TOKEN=

# Google Analytics (GA4)
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

AI_ALLOW_PAID_REVIEW_CALLS=false

# ==============================================================================
# 📝 LOGGING
# ==============================================================================
AI_LOG_DIR=./logs
AI_LOG_LEVEL=INFO
AI_LOG_FORMAT=text
AI_LOG_TO_CONSOLE=false
AI_LLM_MAX_TOKENS=16384
