# Sahm backend -- copy to .env and fill in. Every value has a safe default so
# the app boots with LLM_PROVIDER=mock and no keys at all.

# ------------------------------------------------------------------ environment
# dev | test | prod
SAHM_ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true
# Tenancy (P0). A request may name its tenant with the X-Workspace-Id header
# (the businesses.id it acts on). When this is false a request without the
# header falls back to the oldest business, which keeps single-tenant dev
# working. Set it to true in production: an unnamed request is then rejected
# with "workspace_required" instead of silently reading someone else's data.
REQUIRE_WORKSPACE_HEADER=false

# ------------------------------------------------------------------- auth (P1)
# The backend owns its users and sessions. POST /api/v1/auth/register creates an
# account, POST /auth/login returns a token, and every subsequent request sends it
# as "Authorization: Bearer <token>". Only sha256(token) is stored, so a database
# leak cannot be replayed as a session.
#
# REQUIRE_AUTH is the master switch for the sensitive surface -- tool invocation,
# Meta connect/disconnect, recommendation approve/reject and persona PATCH.
#   false (default) = today's behaviour. An anonymous caller is treated exactly as
#                     it was before authentication existed, so the frontend works
#                     before its login page exists.
#   true             = those endpoints require a valid token (401 otherwise) and
#                     enforce roles: owner-only for Meta connect/disconnect,
#                     member-or-better for the rest. A viewer is read-only.
# Set it to true in production. An *authenticated* caller is always subject to the
# role checks, whatever this says.
REQUIRE_AUTH=false
# How long a session stays valid before /auth/refresh must be called (days).
SESSION_TTL_DAYS=30
# Failed logins for one address before it is temporarily locked. In-process only
# for now; P4.2 replaces this with a real per-user/per-workspace limiter.
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------- database
# SQLite works out of the box and runs the whole flow with no external service.
# Postgres + pgvector is required for production (vector search uses <=>).
DATABASE_URL=sqlite+aiosqlite:///./sahm.db
# DATABASE_URL=postgresql+asyncpg://sahm:CHANGEME@localhost:5432/sahm

# ------------------------------------------------------------------- LLM config
# One provider per tier. Switching provider or model is env-only -- no code
# change. Valid providers: mock | claude | openai
LLM_PROVIDER_FAST=mock
LLM_PROVIDER_STRONG=mock

# Tier -> model. Only these strings exist anywhere in the codebase; changing a
# model is a config edit.
LLM_MODEL_FAST_MOCK=mock-fast-1
LLM_MODEL_STRONG_MOCK=mock-strong-1
LLM_MODEL_FAST_CLAUDE=claude-haiku-4-5-20251001
LLM_MODEL_STRONG_CLAUDE=claude-sonnet-4-5-20250929
LLM_MODEL_FAST_OPENAI=gpt-4o-mini
LLM_MODEL_STRONG_OPENAI=gpt-4o

# Leave blank to use the mock provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------- cost guard
# Per-workspace daily token budget and per-run caps. A run that would exceed
# either returns incomplete:true rather than hanging or overspending.
DAILY_TOKEN_BUDGET=2000000
MAX_TOKENS_PER_RUN=60000
MAX_AGENT_ITERATIONS=6
AGENT_RUN_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------- embeddings
# Which embedder produces vectors: mock (deterministic, offline) or openai.
EMBEDDING_PROVIDER=mock
# Where vectors are stored: auto (pgvector on Postgres, JSON elsewhere),
# pgvector, or python (in-process cosine).
VECTOR_BACKEND=auto
EMBEDDING_DIM=64
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----------------------------------------------------------------- brand memory
# Hard cap on tokens injected into a prompt from brand memory.
BRAND_CONTEXT_TOKEN_CAP=900

# ------------------------------------------------------------------ web search
# none | tavily | serper | brave. "none" makes web_search return unavailable.
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ------------------------------------------------------------------- keywords
# none | dataforseo. "none" makes get_keywords return unavailable.
KEYWORD_PROVIDER=none
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---------------------------------------------------------------------- places
GOOGLE_PLACES_API_KEY=

# --------------------------------------------------------------- SSRF protection
# Scheme allowlist and fetch limits for analyze_website.
WEBSITE_ALLOWED_SCHEMES=http,https
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_MAX_BYTES=2000000

# ------------------------------------------------------------------------- Meta
# Blank means the meta_read tools return unavailable. Tokens are stored
# encrypted at rest; the API key below is only the encryption key.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v21.0
META_API_TIMEOUT_SECONDS=20
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
# 32 url-safe base64 bytes. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If blank, a deterministic dev key is used -- fine for dev, NEVER for prod.
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------- image gen
# mock | openai | stability
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# -------------------------------------------------------------------- uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/webp,text/csv,application/pdf

# ------------------------------------------------------------------------ CORS
# The Next.js dev server origin.
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------------- API
API_PREFIX=/api/v1
APP_NAME=Sahm Marketing OS
