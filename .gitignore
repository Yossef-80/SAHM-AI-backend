# --- Runtime artefacts -------------------------------------------------------
# Local SQLite database (files already tracked stay tracked; new ones are
# ignored from here on).
sahm.db
sahm.db-journal
sahm.db-wal
sahm.db-shm
*.db-journal
var/
uploads/
logs/
*.log

# --- Scraper / debugging output ----------------------------------------------
# Written at runtime, never part of the source tree. `debug.png` is produced by
# app/ai/tools/get_reviews_playwright.py when DEBUG_SCREENSHOT fires.
debug.png
test_image.png
sample_card_*.html
buttons.json
review_cards.json
extractor_result.json
brand_data/

# --- Editor / OS -------------------------------------------------------------
.idea/
.vscode/
.DS_Store

# Memory validation harness output (scripts/validate_memory.py)
memory_validation_results.json
